# ── Local LLM (Ollama) ───────────────────────────────────────────────────────
# Install Ollama: https://ollama.com/download
# Pull a model:   ollama pull phi3
# Other options:  tinyllama (fastest), llama3.1:8b (best quality, needs 8 GB RAM)
OLLAMA_MODEL=phi3
OLLAMA_URL=http://localhost:11434

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma_db

# ── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=5

# ── Fine-tuned encoder (optional) ────────────────────────────────────────────
# Leave blank to use the pre-trained MiniLM backbone
ENCODER_CHECKPOINT=
